<UserControl
  x:Class="Project.Views.FeaturedBannerView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Loaded="OnLoaded"
>
  <Border
    CornerRadius="16"
    Height="180"
    ClipToBounds="True"
    Cursor="Hand"
    MouseLeftButtonUp="OnBannerClick"
  >
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop x:Name="GradStop0" Offset="0" />
        <GradientStop x:Name="GradStop1" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <Grid Margin="24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- Левая часть: тексты и кнопка -->
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <!-- DP BannerTitle -->
        <TextBlock
          Text="{Binding BannerTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
          FontSize="11"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextSecondaryBrush}"
          Margin="0,0,0,6"
        />
        <!-- Основной заголовок из VM как было -->
        <TextBlock
          Text="{Binding FeaturedApps[0].FullName, FallbackValue='Featured App'}"
          FontSize="22"
          FontWeight="Bold"
          Foreground="{DynamicResource FeaturedBannerTextBrush}"
          TextWrapping="Wrap"
          MaxWidth="360"
          Margin="0,0,0,6"
        />
        <TextBlock
          Text="{Binding FeaturedApps[0].Developer}"
          FontSize="13"
          Foreground="{DynamicResource TextSecondaryBrush}"
          Margin="0,0,0,14"
        />
        <Button
          Style="{DynamicResource GetButtonStyle}"
          HorizontalAlignment="Left"
          Command="{Binding OpenDetailCommand}"
          CommandParameter="{Binding FeaturedApps[0]}"
          MinWidth="90"
        >
          <TextBlock Text="{DynamicResource Download}" FontSize="13" />
        </Button>
      </StackPanel>
      <!-- Правая часть: карточка приложения -->
      <Border
        Grid.Column="1"
        Width="100"
        Height="100"
        CornerRadius="8"
        Margin="0,0,8,0"
        Background="{Binding FeaturedApps[0].Color, Converter={StaticResource ColorBrush}}"
      >
        <Border.Effect>
          <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.4" Color="#000000" />
        </Border.Effect>
        <TextBlock
          Text="{Binding FeaturedApps[0].ShortName}"
          FontSize="18"
          FontWeight="Bold"
          Foreground="White"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          MaxWidth="88"
          TextTrimming="CharacterEllipsis"
          TextAlignment="Center"
        />
      </Border>
    </Grid>
  </Border>
</UserControl>
